(executable
 (name main)
 (libraries tkhost threads.posix unix yojson))

; Ui_tcl.file : Tkhost.tcl_file, with ui.tcl embedded and the path of the
; source copy (not the one in _build) for hot reload
(rule
 (target ui_tcl.ml)
 (deps ui.tcl)
 (action
  (with-stdout-to
   %{target}
   (progn
    (echo "let file = { Tkhost.data = {tcl|")
    (cat ui.tcl)
    (echo "|tcl}; path = \"")
    (system "printf %s \"$(pwd | sed 's|/_build/default||')/ui.tcl\"")
    (echo "\" }\n")))))
