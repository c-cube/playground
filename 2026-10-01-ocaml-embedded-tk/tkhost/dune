(library
 (name tkhost)
 (libraries threads.posix unix yojson)
 (foreign_stubs
  (language c)
  (names tkhost_stubs))
 (c_library_flags (-ltcl8.6 -ltk8.6)))

; embed the prelude as Prelude.s
(rule
 (target prelude.ml)
 (deps prelude.tcl)
 (action
  (with-stdout-to
   %{target}
   (progn
    (echo "let s = {tcl|")
    (cat prelude.tcl)
    (echo "|tcl}\n")))))
